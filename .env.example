# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_NAME=know-engine-py
ENVIRONMENT=local

# -----------------------------------------------------------------------------
# DashScope / OpenAI-compatible LLM
# -----------------------------------------------------------------------------
DASHSCOPE_API_KEY=your-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_CHAT_MODEL=qwen-plus
LLM_FAST_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Unit tests default to SQLite. For real smoke/deploy, switch to MySQL.
DATABASE_URL=sqlite+aiosqlite:///:memory:
DATABASE_ECHO=false

# Example remote MySQL:
# DATABASE_URL=mysql+asyncmy://root:your-mysql-root-password@your-mysql-host:23306/know_engine?charset=utf8mb4
# MYSQL_TEST_DATABASE_URL=mysql+asyncmy://root:your-mysql-root-password@your-mysql-host:23306/know_engine?charset=utf8mb4
MYSQL_TEST_DATABASE_URL=

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
# Generate a strong random value for real deployment.
JWT_SECRET_KEY=change-me-to-a-32-byte-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Used by Celery and future cache/chat memory adapters.
REDIS_URL=redis://:your-redis-password@your-redis-host:26379/0

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
# If empty, Celery falls back to REDIS_URL, then memory:// for import/unit tests.
CELERY_BROKER_URL=redis://:your-redis-password@your-redis-host:26379/1
CELERY_RESULT_BACKEND=redis://:your-redis-password@your-redis-host:26379/2

# -----------------------------------------------------------------------------
# MinIO / Object Storage
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=your-minio-host:19000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=know-engine
MINIO_SECURE=false

# -----------------------------------------------------------------------------
# Elasticsearch
# -----------------------------------------------------------------------------
ELASTICSEARCH_URL=http://your-elasticsearch-host:29200
ELASTICSEARCH_INDEX=know_engine_segments

# -----------------------------------------------------------------------------
# Milvus
# -----------------------------------------------------------------------------
# Leave empty if not installed yet.
MILVUS_URI=
MILVUS_COLLECTION=know_engine_segments

# -----------------------------------------------------------------------------
# MinerU
# -----------------------------------------------------------------------------
# Leave empty if not installed yet.
MINERU_BASE_URL=
MINERU_API_KEY=

# -----------------------------------------------------------------------------
# Neo4j
# -----------------------------------------------------------------------------
# v0.1 does not depend on Neo4j / Text-to-Cypher.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
