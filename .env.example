APP_NAME=know-engine-py
ENVIRONMENT=local

DASHSCOPE_API_KEY=your-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

LLM_CHAT_MODEL=qwen-plus
LLM_FAST_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

DATABASE_URL=sqlite+aiosqlite:///:memory:
DATABASE_ECHO=false

# Remote middleware.
# Keep real passwords in .env only; never commit them.

# MySQL
# DATABASE_URL=mysql+asyncmy://root:your-mysql-root-password@your-mysql-host:23306/know_engine?charset=utf8mb4
# MYSQL_TEST_DATABASE_URL=mysql+asyncmy://root:your-mysql-root-password@your-mysql-host:23306/know_engine?charset=utf8mb4

# Redis
REDIS_URL=redis://:your-redis-password@your-redis-host:26379/0

# Elasticsearch
ELASTICSEARCH_URL=http://your-elasticsearch-host:29200
ELASTICSEARCH_INDEX=know_engine_segments

# MinIO
MINIO_ENDPOINT=your-minio-host:19000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=know-engine
MINIO_SECURE=false

# Not installed yet.
MILVUS_URI=
MILVUS_COLLECTION=know_engine_segments

MINERU_BASE_URL=
MINERU_API_KEY=

NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Celery uses Redis when enabled.
CELERY_BROKER_URL=redis://:your-redis-password@your-redis-host:26379/1
CELERY_RESULT_BACKEND=redis://:your-redis-password@your-redis-host:26379/2
